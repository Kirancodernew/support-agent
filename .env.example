# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas — Phase 1
MONGODB_URI=

# Auth — Phase 1 (any long random string; generate with: openssl rand -hex 32)
JWT_SECRET=

# Gemini (chat, tool calling, embeddings) — Phase 2
LLM_PROVIDER=gemini
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_API_KEY=

# Redis — Phase 2 (local Docker default; Redis Cloud URL in deploy)
REDIS_URL=redis://localhost:6379
# Redis Cloud URL; only copied into the host's REDIS_URL at deploy time
REDIS_CLOUD_URL=

# AWS S3 — Phase 2
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

